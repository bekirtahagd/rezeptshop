# Vorlage — kopiere diese Datei als .env und trage echte Werte ein
# .env wird nicht ins Git eingecheckt (steht in .gitignore)

# Datenbank
POSTGRES_DB=rezeptshop
POSTGRES_USER=rezeptshop_user
POSTGRES_PASSWORD=dein-db-passwort

# Verbindungs-URL fuer alle Services (Hostname = Service-Name im Docker-Netzwerk)
DATABASE_URL=postgresql://rezeptshop_user:dein-db-passwort@postgres:5432/rezeptshop

# JWT (muss in auth-service und authorization-service identisch sein)
JWT_SECRET=dein-geheimer-jwt-schluessel

# pgAdmin (nur fuer dev-Profile: docker compose --profile dev up)
PGADMIN_EMAIL=admin@rezeptshop.de
PGADMIN_PASSWORD=dein-pgadmin-passwort

# E-Mail (fuer auth-service: Bestaetigungsmail, Einmal-Links)
# ENTWICKLUNG nutzt Mailpit (Mail-Catcher, kein echter Versand) — Postfach: http://localhost:8025
#   - Lokal (npm start ausserhalb Docker): Mailpit ist unter localhost:1025 erreichbar.
#   - In Docker: docker-compose.yml verdrahtet den Host fest auf "mailpit" (wie DATABASE_URL -> @postgres).
#   - Mailpit braucht keine Authentifizierung -> USER/PASS bleiben leer.
# PRODUKTION: echten SMTP-Server eintragen (z.B. MAIL_HOST=smtp.provider.de, MAIL_PORT=587, USER/PASS gesetzt).
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASS=
MAIL_FROM=Rezeptshop <noreply@rezeptshop.de>

# Basis-URL des user-portals (Frontend) — wird fuer Links in E-Mails genutzt: Bestaetigungslink
# (confirm.html) und Magic-Link (magic.html). Die Seite liest den Token aus der URL und ruft den
# passenden auth-Endpunkt auf, statt rohes JSON anzuzeigen.
# Lokal/Dev: localhost:8080. In Produktion die echte Frontend-Domain eintragen.
FRONTEND_URL=http://localhost:8080

# Service-URLs fuer Service-zu-Service-Calls (z.B. inventory-service -> auth/authorization).
# Lokal (npm start ausserhalb Docker): localhost. In Docker verdrahtet docker-compose.yml
# die Container-Namen (http://auth-service:3001 usw.).
AUTH_SERVICE_URL=http://localhost:3001
AUTHORIZATION_SERVICE_URL=http://localhost:3002

# CORS: erlaubte Frontend-Origins (Komma-getrennt). Der Browser darf nur von diesen Adressen
# auf die Backend-Services zugreifen. user-portal = 8080, admin-portal = 8081.
# Wird beim lokalen "npm start" gelesen; in Docker greift der gleiche Wert als Code-Default.
CORS_ORIGINS=http://localhost:8080,http://localhost:8081
