meta {
  name: GRANT - tom vergibt Recht auf max Wishlist (403 erwartet)
  type: http
  seq: 3
}

post {
  url: {{authorizationBaseUrl}}/api/authorization/grant
  body: json
  auth: none
}

body:json {
  {
    "requesterId": 4,
    "requesterRole": "user",
    "targetUserId": 5,
    "resourceId": 1,
    "resourceType": "wishlist",
    "ownerId": 2,
    "permission": "read"
  }
}

assert {
  res.status: eq 403
}
