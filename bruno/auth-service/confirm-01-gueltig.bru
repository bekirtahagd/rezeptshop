meta {
  name: CONFIRM - Gültiger Token (200)
  type: http
  seq: 4
}

get {
  url: {{authBaseUrl}}/api/auth/confirm/confirm-verify-valid
  auth: none
}

docs {
  Seed-Token confirm-verify-valid (gültig & offen) für verify@test.de → 200 E-Mail bestätigt.
  Achtung: Beim zweiten Aufruf 400 (Token bereits verwendet), da der Token verbraucht wird.
}
