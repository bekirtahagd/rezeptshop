meta {
  name: MAGIC-LINK - Link abgelaufen wird abgelehnt (400/404)
  type: http
  seq: 25
}

get {
  url: {{authBaseUrl}}/api/auth/magic-login/magic-magic-expired
  auth: none
}

tests {
  // Garantie: ein abgelaufener Magic-Link stellt NIE ein JWT aus.
  // 400 = Token noch in der DB, als "abgelaufen" abgelehnt.
  // 404 = der Cleanup-Job (cleanup.js) hat den abgelaufenen Seed-Token beim
  //        Service-Start bereits entfernt → "Token nicht gefunden".
  // Beide Wege sind eine gültige Ablehnung (robust gegen das Cleanup-Timing).
  test("abgelaufener Magic-Link wird abgelehnt (400 oder 404)", function () {
    expect([400, 404]).to.include(res.getStatus());
  });
  test("kein JWT bei abgelaufenem Link", function () {
    expect(res.getBody().token).to.be.undefined;
  });
}

docs {
  Fehlerfall AUTH-5: abgelaufener Token aus den Dummy-Daten.
  Erwartet: Ablehnung ohne JWT. 400 "Token abgelaufen", falls noch vorhanden;
  404 "Token nicht gefunden", falls der Cleanup-Job ihn beim Start schon gelöscht
  hat. Dieser Seed-Token ändert keinen Zustand → beliebig oft wiederholbar.
}
