meta {
  name: REGISTER - Doppelte E-Mail (409)
  type: http
  seq: 2
}

post {
  url: {{authBaseUrl}}/api/auth/register
  body: json
  auth: none
}

body:json {
  {
    "email": "verify@test.de",
    "password": "Test1234!"
  }
}

assert {
  res.status: eq 409
}

docs {
  verify@test.de stammt aus den Dummy-Daten → muss mit 409 (E-Mail bereits registriert)
  abgelehnt werden.
}
