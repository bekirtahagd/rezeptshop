meta {
  name: VALIDATE - Ungültiges Token (valid:false)
  type: http
  seq: 16
}

post {
  url: {{authBaseUrl}}/api/auth/validate
  body: json
  auth: none
}

body:json {
  {
    "token": "kaputter.token.string"
  }
}

assert {
  res.status: eq 200
  res.body.valid: eq false
}

docs {
  Ungültiger/gefälschter Token → 200 { valid: false } (kein Fehlerstatus, bewusst).
  Andere Services lehnen den Request dann mit ihrem eigenen 401 ab.
}
