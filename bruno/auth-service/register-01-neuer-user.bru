meta {
  name: REGISTER - Neuer User (201)
  type: http
  seq: 1
}

post {
  url: {{authBaseUrl}}/api/auth/register
  body: json
  auth: none
}

body:json {
  {
    "email": "{{regEmail}}",
    "password": "Test1234!"
  }
}

script:pre-request {
  // Bei jedem Lauf eine eindeutige E-Mail erzeugen, damit register IMMER 201 liefert
  // (statt 409 beim zweiten Mal). Die Adresse wird in confirm-00 wiederverwendet.
  bru.setVar("regEmail", "regtest_" + Date.now() + "@test.de");
}

assert {
  res.status: eq 201
  res.body.message: isDefined
}

docs {
  Erfolgsfall AUTH-1: legt bei jedem Lauf einen neuen User mit eindeutiger E-Mail an → immer 201.
  Die Bestätigungsmail landet in Mailpit (http://localhost:8025); confirm-00 holt sich daraus
  den frischen Token. Dadurch ist der komplette Ordner beliebig oft wiederholbar.
}
