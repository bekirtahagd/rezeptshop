meta {
  name: VALIDATE - Gültiges Token (valid:true)
  type: http
  seq: 15
}

post {
  url: {{authBaseUrl}}/api/auth/validate
  body: json
  auth: none
}

body:json {
  {
    "token": "{{token}}"
  }
}

assert {
  res.status: eq 200
  res.body.valid: eq true
}

docs {
  Interner Endpunkt für andere Services. Vorher login-01 ausführen ({{token}} muss gesetzt sein).
  → 200 { valid: true, userId, role, email }.
  Prüft Signatur + Blacklist + live in der DB, ob der User existiert und nicht gesperrt ist.
}
