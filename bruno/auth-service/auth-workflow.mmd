%% Auth-Service — Gesamter Workflow
%% Implementiert: AUTH-1 (register), AUTH-2 (confirm)
%% Geplant:       AUTH-3 (login), AUTH-4 (logout), AUTH-5a/b (magic-link)
%%
%% Hinweis zu GET /confirm/:token:
%%   GET ist korrekt, weil der Link direkt aus dem E-Mail-Client geoeffnet wird.
%%   Browser und Mail-Clients koennen aus einem Link-Klick nur GET ausfuehren.
%%   Seiteneffekte (email_verified setzen) sind bei diesem Pattern industrie-ueblich.

flowchart TD

    %% ══════════════════════════════════════════════════════════
    %% AUTH-1 · REGISTER
    %% ══════════════════════════════════════════════════════════
    subgraph REG["AUTH-1 · POST /api/auth/register  ✅ implementiert"]
        R_IN([Client sendet\nemail + password])

        R_IN   --> RV1{email und password\nvorhanden?}
        RV1    -- Nein --> RE1["400\nemail und password sind erforderlich"]
        RV1    -- Ja   --> RV2{E-Mail-Format\ngueltig?\nREGEX-Pruefung}
        RV2    -- Nein --> RE2["400\nUngültiges E-Mail-Format"]
        RV2    -- Ja   --> RV3{Passwort\nmin. 8 Zeichen?}
        RV3    -- Nein --> RE3["400\nPasswort muss mindestens 8 Zeichen lang sein"]
        RV3    -- Ja   --> RDB1[("PostgreSQL\nSELECT 1 FROM users\nWHERE email = $1")]
        RDB1   --> RV4{E-Mail bereits\nregistriert?}
        RV4    -- Ja   --> RE4["409\nE-Mail bereits registriert"]
        RV4    -- Nein --> RHASH["bcryptjs\nbcrypt.hash(password, 10)\nSaltrunden = 10 ~ 100ms\nEin-Weg-Hash, nicht umkehrbar\n→ passwordHash"]
        RHASH  --> RTOKEN["Node.js crypto\ncrypto.randomBytes(32).toString('hex')\n= 64-Zeichen Hex-String\n256 Bit Entropie"]
        RTOKEN --> RTX["BEGIN TRANSACTION"]
        RTX    --> RDB2[("INSERT INTO users\nemail: email\npassword: passwordHash\nrole: 'user'\nlocked: false\nemail_verified: false")]
        RDB2   --> RDB3[("INSERT INTO verification_tokens\ntoken: token\nuser_id: userId\ntype: 'email_verification'\nexpires_at: NOW + 24 Stunden\nused: false")]
        RDB3   --> RCOMMIT["COMMIT"]

        RCOMMIT --> ROK["201\nRegistriert. Bitte E-Mail bestaetigen."]
        RCOMMIT --> RMAIL["Nodemailer\nsendVerificationMail(email, token)"]
        RMAIL   --> RSMTP{Umgebung?}
        RSMTP   -- DEV  --> RMAILPIT[("Mailpit :1025\nkein Auth erforderlich\nsichtbar: localhost:8025")]
        RSMTP   -- PROD --> RSMTPREAL[("Echter SMTP :587\nauth: MAIL_USER + MAIL_PASS")]
        RMAILPIT & RSMTPREAL --> RLINK["Mail-Inhalt\nBetreff: Bitte bestaetigen...\nLink: AUTH_PUBLIC_URL/api/auth/confirm/TOKEN\nGueltig: 24 Stunden"]
    end

    %% ══════════════════════════════════════════════════════════
    %% AUTH-2 · CONFIRM
    %% ══════════════════════════════════════════════════════════
    subgraph CONF["AUTH-2 · GET /api/auth/confirm/:token  ✅ implementiert"]
        C_IN([User klickt Link in der Mail\nBrowser oeffnet URL als GET-Request\nGET ist korrekt — kein Mail-Client\nkann aus Link-Klick einen POST machen])

        C_IN    --> CDB1[("PostgreSQL\nSELECT token_id, user_id,\nused, expires_at\nFROM verification_tokens\nWHERE token = $1\nAND type = 'email_verification'")]
        CDB1    --> CV1{Token\ngefunden?}
        CV1     -- Nein --> CE1["404\nToken nicht gefunden"]
        CV1     -- Ja   --> CV2{used = true?}
        CV2     -- Ja   --> CE2["400\nToken bereits verwendet"]
        CV2     -- Nein --> CV3{expires_at\nkleiner als NOW?}
        CV3     -- Ja   --> CE3["400\nToken abgelaufen"]
        CV3     -- Nein --> CTX["BEGIN TRANSACTION"]
        CTX     --> CDB2[("UPDATE users\nSET email_verified = true\nWHERE user_id = $1")]
        CDB2    --> CDB3[("UPDATE verification_tokens\nSET used = true\nWHERE token_id = $1")]
        CDB3    --> CCOMMIT["COMMIT"]
        CCOMMIT --> COK["200\nE-Mail bestaetigt"]
    end

    %% Verbindung Register → Confirm (ueber E-Mail)
    RLINK -.->|"User oeffnet Mail\nklickt Bestaeitigungslink"| C_IN

    %% ══════════════════════════════════════════════════════════
    %% AUTH-3 · LOGIN (geplant)
    %% ══════════════════════════════════════════════════════════
    subgraph LOGIN["AUTH-3 · POST /api/auth/login  🔲 noch nicht implementiert"]
        L_IN([Client: email + password])

        L_IN   --> LDB1[("SELECT user_id, password,\nemail_verified, locked\nFROM users WHERE email = $1")]
        LDB1   --> LV1{User\ngefunden?}
        LV1    -- Nein --> LE1["401\nUngueltige Anmeldedaten"]
        LV1    -- Ja   --> LV2{email_verified\n= true?}
        LV2    -- Nein --> LE2["403\nE-Mail nicht bestaetigt"]
        LV2    -- Ja   --> LV3{locked\n= true?}
        LV3    -- Ja   --> LE3["403\nAccount gesperrt"]
        LV3    -- Nein --> LBCRYPT["bcryptjs\nbcrypt.compare(eingabe, gespeicherterHash)\nExtrahiert Salt aus Hash\nvergleicht — ohne Plaintext zu kennen"]
        LBCRYPT --> LV4{Passwort\nkorrekt?}
        LV4    -- Nein --> LE4["401\nUngueltige Anmeldedaten"]
        LV4    -- Ja   --> LJWT["jsonwebtoken\njwt.sign\nPayload: userId, role, email\nSecret: JWT_SECRET aus .env\nExpiry: geplant 7d"]
        LJWT   --> LOK["200\n{ token: JWT }"]
    end

    %% ══════════════════════════════════════════════════════════
    %% AUTH-4 · LOGOUT (geplant)
    %% ══════════════════════════════════════════════════════════
    subgraph LOGOUT["AUTH-4 · POST /api/auth/logout  🔲 noch nicht implementiert"]
        LO_IN([Client sendet JWT\nim Authorization-Header])

        LO_IN --> LOV{JWT gueltig?}
        LOV   -- Nein --> LOERR["401\nUngültiger Token"]
        LOV   -- Ja   --> LODB[("Token auf Blacklist setzen\noder Token-Rotation:\nneues Token ausgeben,\naltes invalidieren")]
        LODB  --> LOOK["200\nErfolgreich ausgeloggt"]
    end

    %% ══════════════════════════════════════════════════════════
    %% AUTH-5a · MAGIC-LINK ANFORDERN (geplant)
    %% ══════════════════════════════════════════════════════════
    subgraph MAGIC_REQ["AUTH-5a · POST /api/auth/magic-link  🔲 noch nicht implementiert"]
        ML_IN([Client: nur email\nkein Passwort noetig])

        ML_IN   --> MLDB1[("SELECT user_id\nFROM users WHERE email = $1")]
        MLDB1   --> MLV1{User\nexistiert?}
        MLV1    -- Nein --> MLOK1["200 — kein Fehler!\nUser-Enumeration verhindern:\nAngreifer darf nicht wissen\nob E-Mail registriert ist"]
        MLV1    -- Ja   --> MLTOKEN["crypto.randomBytes(32).toString('hex')\n→ Magic-Link-Token"]
        MLTOKEN --> MLDB2[("INSERT INTO verification_tokens\ntype: 'magic_link'\nexpires_at: NOW + 15 Minuten\nused: false")]
        MLDB2   --> MLMAIL["Mail:\nAUTH_PUBLIC_URL/api/auth/magic-login/TOKEN\nKuerzer gueltig als Bestaetigung: nur 15min"]
        MLMAIL  --> MLOK2["200\nFalls vorhanden, Mail gesendet"]
    end

    %% ══════════════════════════════════════════════════════════
    %% AUTH-5b · MAGIC-LOGIN (geplant)
    %% ══════════════════════════════════════════════════════════
    subgraph MAGIC_LOGIN["AUTH-5b · GET /api/auth/magic-login/:token  🔲 noch nicht implementiert"]
        ML2_IN([User klickt Magic-Link\naus der Mail])

        ML2_IN  --> ML2DB1[("SELECT user_id, used, expires_at\nFROM verification_tokens\nWHERE token = $1\nAND type = 'magic_link'")]
        ML2DB1  --> ML2V1{Token gefunden,\nnicht benutzt\nund nicht abgelaufen?}
        ML2V1   -- Nein --> ML2ERR["400 / 404\nToken ungueltig"]
        ML2V1   -- Ja   --> ML2USED[("UPDATE verification_tokens\nSET used = true")]
        ML2USED --> ML2JWT["jwt.sign\nuserId, role, email\n→ JWT ausgestellt"]
        ML2JWT  --> ML2OK["200\n{ token: JWT }"]
    end

    %% Verbindung Magic-Link-Mail → Magic-Login
    MLMAIL -.->|"User klickt\nMagic-Link"| ML2_IN
