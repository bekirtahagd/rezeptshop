meta {
  name: USER-1 - Unbekannte ID (404)
  type: http
  seq: 6
}

get {
  url: {{userBaseUrl}}/api/users/999999
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{adminToken}}
}

assert {
  res.status: eq 404
}

docs {
  USER-1: Admin liest eine nicht existierende ID → 404 (Berechtigung ok, User aber nicht da).
}
