meta {
  name: GET Liste mit Produkt (max) → 200
  type: http
  seq: 9
}

get {
  url: {{wishlistBaseUrl}}/api/wishlists/{{newListId}}
  auth: none
}

headers {
  Authorization: Bearer {{token}}
}

assert {
  res.status: eq 200
  res.body.products[0].product_id: eq 1
}

docs {
  Liste enthält jetzt das hinzugefügte Produkt (JOIN auf products).
}
