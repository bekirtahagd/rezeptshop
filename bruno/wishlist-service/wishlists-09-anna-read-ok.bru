meta {
  name: GET geteilte Liste (anna, read) → 200
  type: http
  seq: 12
}

get {
  url: {{wishlistBaseUrl}}/api/wishlists/{{newListId}}
  auth: none
}

headers {
  Authorization: Bearer {{annaToken}}
}

assert {
  res.status: eq 200
  res.body.list_id: isDefined
}

docs {
  Nach dem Share darf anna die Liste lesen (read-Permission greift im authorization-service).
}
