meta {
  name: INV-5 - Produkt bearbeiten als Admin (200)
  type: http
  seq: 9
}

put {
  url: {{inventoryBaseUrl}}/api/products/{{newProductId}}
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{adminToken}}
}

body:json {
  {
    "price": 12.50,
    "amount": 5,
    "allergens": "Gluten, Eier",
    "recipe": "1. Aktualisierte Zubereitung."
  }
}

assert {
  res.status: eq 200
  res.body.price: eq "12.50"
  res.body.amount: eq 5
  res.body.allergens: eq Gluten, Eier
  res.body.recipe: eq 1. Aktualisierte Zubereitung.
}

docs {
  INV-5: Admin ändert nur die übergebenen Felder (price, amount, allergens, recipe) des in
  products-04 erstellten Produkts ({{newProductId}}). Andere Felder bleiben unverändert.
}
