meta {
  name: LOGIN - Admin → setzt {{adminToken}}
  type: http
  seq: 2
}

post {
  url: {{authBaseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "admin@test.de",
    "password": "Test1234!"
  }
}

script:post-response {
  // JWT des Admins in {{adminToken}} ablegen — für Produkt-Schreiboperationen.
  if (res.status === 200 && res.body.token) {
    bru.setEnvVar("adminToken", res.body.token);
  }
}

assert {
  res.status: eq 200
  res.body.token: isDefined
}

docs {
  Setup: meldet admin@test.de an und speichert das JWT in {{adminToken}}.
  Muss vor den Produkt-Schreib-Requests (create/update/delete) laufen.
}
