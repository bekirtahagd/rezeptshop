meta {
  name: LOGIN - User (max) → setzt {{token}}
  type: http
  seq: 1
}

post {
  url: {{authBaseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "max@test.de",
    "password": "Test1234!"
  }
}

script:post-response {
  // JWT des normalen Users in {{token}} ablegen — alle User-Requests nutzen ihn.
  if (res.status === 200 && res.body.token) {
    bru.setEnvVar("token", res.body.token);
  }
}

assert {
  res.status: eq 200
  res.body.token: isDefined
}

docs {
  Setup: meldet max@test.de (verifiziert) an und speichert das JWT in {{token}}.
  Muss vor allen User-Requests (Produkte lesen, Warenkorb, Kauf) laufen.
}
