meta {
  name: INV-6 - Nicht verfügbares Produkt (409)
  type: http
  seq: 12
}

post {
  url: {{inventoryBaseUrl}}/api/cart
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
}

body:json {
  {
    "productId": 6,
    "quantity": 1
  }
}

assert {
  res.status: eq 409
}

docs {
  INV-6 Kernregel: "Nicht möglich wenn Produkt nicht verfügbar ist." Produkt 6
  ("Rindersteak Marinade") hat amount = 0 → der Warenkorb-Eintrag wird mit 409 abgelehnt.
}
